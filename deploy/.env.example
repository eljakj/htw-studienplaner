# Copy this file to .env (git-ignored). It contains no secrets.

# Image tag: "latest" (newest build of main) or a commit tag such as
# sha-0123456 to roll back to an older build.
IMAGE_TAG=latest

# Port on the VM that the Cloudflare Tunnel route points to.
HOST_PORT=8085

# Address to listen on. 0.0.0.0 = every interface. Set the VM's LAN address
# (for example 192.168.178.15) to listen on that interface only.
BIND_ADDRESS=0.0.0.0
